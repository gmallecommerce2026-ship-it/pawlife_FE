+  // MARK: - replacePassFromUrl
+
+  // Thay thế IM LẶNG một thẻ đã có trong Wallet bằng bản mới cùng
+  // (passTypeIdentifier, serialNumber) — không hiện PKAddPassesViewController.
+  // Dùng khi dữ liệu thú cưng đổi (tên/ảnh) và cần làm mới thẻ trong ví.
+  // Trả về PASS_NOT_FOUND nếu thẻ chưa có sẵn — khi đó phải dùng addPassFromUrl.
+  @MainActor @objc(replacePassFromUrl:headers:completion:)
+  public func replacePassFromUrl(_ passUrlString: String,
+                                 headers: [String: String]?,
+                                 completion: @escaping (Bool, String?, String?) -> Void
+  ) {
+    guard let url = URL(string: passUrlString) else {
+      completion(false, "INVALID_URL", "The pass URL is invalid")
+      return
+    }
+
+    var request = URLRequest(url: url)
+    request.httpMethod = "GET"
+
+    if let headers = headers {
+      for (key, value) in headers {
+        request.setValue(value, forHTTPHeaderField: key)
+      }
+    }
+
+    URLSession.shared.dataTask(with: request) { data, response, error in
+      if let error = error {
+        DispatchQueue.main.async {
+          completion(false, "NETWORK_ERROR", error.localizedDescription)
+        }
+        return
+      }
+
+      if let httpResponse = response as? HTTPURLResponse, !(200...299).contains(httpResponse.statusCode) {
+        DispatchQueue.main.async {
+          completion(false, "HTTP_ERROR", "HTTP \(httpResponse.statusCode)")
+        }
+        return
+      }
+
+      guard let data = data else {
+        DispatchQueue.main.async {
+          completion(false, "INVALID_DATA", "No data received")
+        }
+        return
+      }
+
+      DispatchQueue.main.async {
+        guard let pass = try? PKPass(data: data) else {
+          completion(false, "INVALID_PASS", "Failed to parse pass data")
+          return
+        }
+        // replacePass trả false khi thẻ chưa có trong ví hoặc app thiếu entitlement
+        // com.apple.developer.pass-type-identifiers cho pass type này.
+        let replaced = PKPassLibrary().replacePass(with: pass)
+        if replaced {
+          completion(true, nil, nil)
+        } else {
+          completion(false, "PASS_NOT_FOUND", "Pass is not in the library or app lacks entitlement")
+        }
+      }
+    }.resume()
+  }
+
