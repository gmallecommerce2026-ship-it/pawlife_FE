      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ứng dụng cần quyền vị trí để gửi tọa độ giúp chủ nhân tìm lại thú cưng bị lạc."
        }
      ],
      [
        "@rnmapbox/maps",
        {
          "RNMapboxMapsDownloadToken": "",
