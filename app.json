{
  "expo": {
    "name": "PawLife",
    "slug": "pet-id-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "petidapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.annguyen.pawlife",
      "config": {
        "googleMapsApiKey": "AIzaSyDSiggtEz29dOMLPbALCl4YBAvxJTWKgAU"
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "maps",
          "comgooglemaps"
        ],
        "SKAdNetworkItems": [
          { "SKAdNetworkIdentifier": "v9wttpbfk9.skadnetwork" },
          { "SKAdNetworkIdentifier": "n38lu8286q.skadnetwork" }
        ],

        "ITSAppUsesNonExemptEncryption": false,

        "NSCameraUsageDescription": "PawLife cần quyền Camera để quét mã QR trên thẻ định danh thú cưng và hỗ trợ tìm kiếm thú cưng thất lạc.",

        "NSPhotoLibraryUsageDescription": "PawLife cần truy cập thư viện ảnh để cập nhật ảnh hồ sơ cá nhân và thú cưng.",

        "NSPhotoLibraryAddUsageDescription": "PawLife cần quyền lưu ảnh để bạn có thể tải mã QR, thẻ thú cưng và ảnh hồ sơ y tế về thư viện ảnh trên thiết bị.",

        "NSLocationWhenInUseUsageDescription": "PawLife cần quyền vị trí để gửi tọa độ hỗ trợ tìm kiếm thú cưng thất lạc, hiển thị nội dung phù hợp gần bạn và tính toán khoảng cách, chỉ đường chính xác từ bạn đến nơi thú cưng vừa được quét mã.",

        "NSLocationAlwaysAndWhenInUseUsageDescription": "PawLife cần quyền vị trí để hỗ trợ các tính năng tìm kiếm thú cưng thất lạc ngay cả khi ứng dụng đang chạy nền.",

      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.annguyen.pawlife",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-localization",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ứng dụng cần sử dụng Face ID để bảo mật tài khoản của bạn."
        }
      ],
